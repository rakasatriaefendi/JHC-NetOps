# Required only for explicit Supabase compatibility; local_postgres does not construct
# a Supabase client unless a compatibility branch is selected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Explicit application DB authority. Local Auth requires local_postgres; transitional Supabase Realtime remains separate.
PERSISTENCE_AUTHORITY=local_postgres

# Server-only connection to the loopback local backend. Never use NEXT_PUBLIC_ for the token.
LOCAL_BACKEND_URL=http://127.0.0.1:3402
LOCAL_BACKEND_FRONTEND_TOKEN=REPLACE_WITH_THE_BACKEND_FRONTEND_API_TOKEN
