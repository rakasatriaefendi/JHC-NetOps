#!/usr/bin/env bash
set -euo pipefail

NMAP=/usr/bin/nmap
mode="${1:-}"
target="${2:-}"

[[ $# -eq 2 ]] || { echo "invalid invocation" >&2; exit 64; }
[[ -x "$NMAP" ]] || { echo "nmap unavailable" >&2; exit 69; }

ipv4_number() {
  local value="$1" a b c d extra
  IFS=. read -r a b c d extra <<<"$value"
  [[ -z "${extra:-}" && "$a" =~ ^(0|[1-9][0-9]{0,2})$ && "$b" =~ ^(0|[1-9][0-9]{0,2})$ && "$c" =~ ^(0|[1-9][0-9]{0,2})$ && "$d" =~ ^(0|[1-9][0-9]{0,2})$ ]] || return 1
  (( 10#$a <= 255 && 10#$b <= 255 && 10#$c <= 255 && 10#$d <= 255 )) || return 1
  printf '%u' "$(( (10#$a << 24) + (10#$b << 16) + (10#$c << 8) + 10#$d ))"
}

private_ipv4() {
  local ip="$1" a b
  IFS=. read -r a b _ <<<"$ip"
  [[ "$a" == 10 || ( "$a" == 172 && 10#$b -ge 16 && 10#$b -le 31 ) || ( "$a" == 192 && "$b" == 168 ) ]]
}

valid_host() {
  ipv4_number "$1" >/dev/null && private_ipv4 "$1"
}

valid_network() {
  local cidr="$1" ip prefix numeric size base last
  [[ "$cidr" =~ ^([^/]+)/([0-9]{1,2})$ ]] || return 1
  ip="${BASH_REMATCH[1]}"; prefix="${BASH_REMATCH[2]}"
  numeric="$(ipv4_number "$ip")" || return 1
  (( 10#$prefix >= 22 && 10#$prefix <= 32 )) || return 1
  size=$(( 1 << (32 - 10#$prefix) )); base=$(( numeric / size * size )); last=$(( base + size - 1 ))
  (( numeric == base && size <= 1024 )) || return 1
  private_ipv4 "$ip" || return 1
  local last_ip="$((last >> 24 & 255)).$((last >> 16 & 255)).$((last >> 8 & 255)).$((last & 255))"
  private_ipv4 "$last_ip"
}

case "$mode" in
  discovery)
    valid_network "$target" || { echo "invalid discovery target" >&2; exit 64; }
    exec "$NMAP" -sn -PR --send-ip -T4 -oX - "$target"
    ;;
  discovery-routed)
    valid_network "$target" || { echo "invalid discovery target" >&2; exit 64; }
    exec "$NMAP" -sn -PE -PS22,80,443 -PA80,443 -T4 --max-retries 1 --host-timeout 3s -oX - "$target"
    ;;
  fingerprint)
    valid_host "$target" || { echo "invalid fingerprint target" >&2; exit 64; }
    exec "$NMAP" -Pn -O -sV --version-light --osscan-guess --open -oX - "$target"
    ;;
  *)
    echo "invalid mode" >&2
    exit 64
    ;;
esac
