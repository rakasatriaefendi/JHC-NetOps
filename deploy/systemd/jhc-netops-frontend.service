[Unit]
Description=JHC NetOps Next.js frontend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mini-pc
Group=mini-pc
WorkingDirectory=/var/www/jhc/jhc_noc/current/frontend
ExecStart=/usr/bin/bash /var/www/jhc/jhc_noc/current/deploy/run-frontend.sh
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
