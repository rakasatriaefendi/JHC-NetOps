[Unit]
Description=JHC NetOps Next.js frontend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mini-pc
Group=mini-pc
WorkingDirectory=/var/www/jhc/jhc_noc/current/frontend
EnvironmentFile=/var/www/jhc/jhc_noc/shared/frontend/.env
Environment=NODE_ENV=production
ExecStartPre=/home/mini-pc/.nvm/versions/node/v22.23.2/bin/node /var/www/jhc/jhc_noc/current/deploy/check-frontend-port.mjs --host 192.168.1.130 --port 3401
ExecStart=/home/mini-pc/.nvm/versions/node/v22.23.2/bin/node /var/www/jhc/jhc_noc/current/frontend/node_modules/next/dist/bin/next start --hostname 192.168.1.130 --port 3401
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
