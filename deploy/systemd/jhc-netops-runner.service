[Unit]
Description=JHC NetOps native Ubuntu runner
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mini-pc
Group=mini-pc
WorkingDirectory=/var/www/jhc/jhc_noc/current
ExecStart=/usr/bin/bash /var/www/jhc/jhc_noc/current/deploy/run-runner.sh
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=35s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
