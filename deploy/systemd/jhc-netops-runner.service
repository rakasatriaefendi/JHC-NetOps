[Unit]
Description=JHC NetOps native Ubuntu runner
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mini-pc
Group=mini-pc
WorkingDirectory=/var/www/jhc/jhc_noc/current/runner
EnvironmentFile=/var/www/jhc/jhc_noc/shared/runner/.env
ExecStart=/home/mini-pc/.nvm/versions/node/v22.23.2/bin/node /var/www/jhc/jhc_noc/current/runner/src/main.mjs --config /var/www/jhc/jhc_noc/shared/runner/config.json
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=35s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
