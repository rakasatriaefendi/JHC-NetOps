HOST=127.0.0.1
PORT=3402
RUNNER_API_TOKEN=REPLACE_WITH_A_RANDOM_SHARED_TOKEN_OF_AT_LEAST_32_CHARACTERS
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_THE_EXISTING_SERVER_SIDE_SERVICE_ROLE_KEY

# Optional until P10C is enabled. These values must be configured together.
# This URL is deliberately constrained to the dedicated 16/jhcnetops cluster.
DATABASE_URL=postgresql://jhc_netops_app:REPLACE_WITH_A_RANDOM_PASSWORD@127.0.0.1:5433/jhc_netops
FRONTEND_API_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_SERVER_TO_SERVER_TOKEN

# Optional explicit active inventory scanner. Empty means scanner unavailable.
# Use canonical RFC1918 IPv4 CIDRs only; comma-separate at most 8 networks.
ASSET_SCAN_NETWORKS=
ASSET_SCAN_HELPER_PATH=/usr/local/libexec/jhc-netops-asset-scan
ASSET_SCAN_CONCURRENCY=4
ASSET_SCAN_HOST_TIMEOUT_MS=45000
ASSET_SCAN_DISCOVERY_TIMEOUT_MS=120000
