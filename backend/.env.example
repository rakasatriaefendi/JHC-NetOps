HOST=127.0.0.1
PORT=3402
RUNNER_API_TOKEN=REPLACE_WITH_A_RANDOM_SHARED_TOKEN_OF_AT_LEAST_32_CHARACTERS
PERSISTENCE_AUTHORITY=local_postgres
# Historical P13 candidate mode is unavailable in the local-only runtime.
P13_CANDIDATE_READ_ONLY=false

# Application repositories and Asset/Medical modules use the same exact dedicated
# cluster through separately named compatibility settings.
APPLICATION_DATABASE_URL=postgresql://jhc_netops_app:REPLACE_WITH_A_RANDOM_PASSWORD@127.0.0.1:5433/jhc_netops
DATABASE_URL=postgresql://jhc_netops_app:REPLACE_WITH_A_RANDOM_PASSWORD@127.0.0.1:5433/jhc_netops
MEDICAL_DUE_SOON_DAYS=30
FRONTEND_API_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_SERVER_TO_SERVER_TOKEN
# Persistent filesystem location shared across application releases.
REPORT_BRANDING_DIR=/var/www/jhc/jhc_noc/shared/branding

# Optional one-time bootstrap for Scan Networks. Database settings become the
# runtime authority after first initialization and are never overwritten by env.
# Use RFC1918 IPv4 CIDRs (/22 or narrower); comma-separate at most 8 networks.
ASSET_SCAN_NETWORKS=
ASSET_SCAN_HELPER_PATH=/usr/local/libexec/jhc-netops-asset-scan
ASSET_SCAN_CONCURRENCY=4
ASSET_SCAN_HOST_TIMEOUT_MS=45000
ASSET_SCAN_DISCOVERY_TIMEOUT_MS=120000
