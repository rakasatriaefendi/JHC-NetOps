{
  "name": "jhc-netops-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:postgres:assets": "node --import tsx --test tests/integration/assets-postgres.integration.ts",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@excel.js/exceljs": "0.15.0",
    "fastify": "^5.12.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.15.5",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
