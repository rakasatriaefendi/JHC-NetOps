PERSISTENCE_AUTHORITY=local_postgres
LOCAL_BACKEND_URL=
LOCAL_BACKEND_TOKEN=
ENABLE_DIAGNOSTIC_DEMO=false
# local_postgres requires both LOCAL_BACKEND values.
# Managed telemetry secrets live ONLY in config.local.json (snmp_credential_profiles).
# Keep that file restricted to the runner OS account (e.g. chmod 600 on POSIX).
# SNMP_PROFILE_* environment variables are intentionally NOT supported.
