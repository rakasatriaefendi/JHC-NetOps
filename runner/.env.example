SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_BACKEND_URL=
LOCAL_BACKEND_TOKEN=
ENABLE_DIAGNOSTIC_DEMO=false
# Set both values to route heartbeat and recurring Health, Traffic, and Managed
# Telemetry data-plane operations through the loopback backend.
# Leave both empty for the controlled recurring-data-plane Edge rollback mode.
# Managed telemetry secrets live ONLY in config.local.json (snmp_credential_profiles).
# Keep that file restricted to the runner OS account (e.g. chmod 600 on POSIX).
# SNMP_PROFILE_* environment variables are intentionally NOT supported.
