{
  "runner_id": "local-wsl-runner",
  "display_name": "Local WSL Diagnostic Runner",
  "wsl_distro": "Ubuntu-22.04",
  "wsl_project_root": "/mnt/c/Users/CHANGE_ME/path/to/Network-Monitoring",
  "agent_executable": "agent/.venv/bin/network-monitor",
  "environment_file": ".env",
  "enable_diagnostic_demo": false,
  "enable_manual_ping": false,
  "source_locations": ["Local Development"],
  "targets": [
    {
      "id": "localhost-demo",
      "label": "Localhost — TEST ENVIRONMENT",
      "host": "127.0.0.1",
      "iperf_port": 5201,
      "environment": "localhost_demo",
      "enabled": true
    }
  ],
  "durations": [5, 10],
  "traffic_interface": "eth0",
  "traffic_durations_seconds": [300, 600, 900, 1800],
  "poll_interval_ms": 2000,
  "heartbeat_interval_ms": 10000,
  "enable_snmp_telemetry": false,
  "snmp_max_concurrent": 2,
  "snmp_timeout_seconds": 3,
  "snmp_poll_intervals_seconds": [30, 60],
  "snmp_credential_profiles": {
    "monitoring-readonly-v3": {
      "version": "3",
      "username": "monitoring-readonly",
      "auth_protocol": "SHA256",
      "auth_password": "CHANGE_ME_AUTH_PASSWORD",
      "priv_protocol": "AES128",
      "priv_password": "CHANGE_ME_PRIV_PASSWORD"
    },
    "monitoring-readonly-v2c": {
      "version": "2c",
      "community": "CHANGE_ME_READONLY_COMMUNITY"
    }
  }
}
